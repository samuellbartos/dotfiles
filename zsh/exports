# EDITOR
export EDITOR='nvim'

# PAGER
export LESS="--quit-if-one-screen --no-init --IGNORE-CASE --RAW-CONTROL-CHARS --tabs=4"
export LESSHISTFILE=-

# HISTORY
export HISTFILE="$XDG_STATE_HOME"/zsh/history  # zsh history file location
export HISTORY_IGNORE='(l|l *|cd|cd *|cat *|cp *|mv *|nvim|nvim *|man *|pwd|exit)'
export SAVEHIST=1000000
export HISTSIZE=1000000

# LS
export LSCOLORS=exdxxxxxbxbxxxxxxxxxxx

# RIPGREP
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/rg/config"

# FZF
source <(fzf --zsh)
export FZF_DEFAULT_OPTS_FILE="$XDG_CONFIG_HOME/fzf/config"
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob \!.git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# PYTHON
export IPYTHONDIR="$XDG_CONFIG_HOME/ipython"  # ipython
export PYTHONPYCACHEPREFIX="$XDG_CACHE_HOME/python"
export PYTHONUNBUFFERED="1"  # don't buffer stdout
export UV_MANAGED_PYTHON=1
export UV_NATIVE_TLS=true
export RUFF_CACHE_DIR="$XDG_CACHE_HOME/ruff"
export MYPY_CACHE_DIR="$XDG_CACHE_HOME/mypy"
export PYTEST_ADDOPTS="--override-ini cache_dir=$XDG_CACHE_HOME/pytest"

# HASKELL
export GHCUP_USE_XDG_DIRS=1  # ghcup
export CABAL_CONFIG="$XDG_CONFIG_HOME/cabal/config"  # cabal

# AWS
export AWS_SHARED_CREDENTIALS_FILE="$XDG_CONFIG_HOME/aws/credentials"
export AWS_CONFIG_FILE="$XDG_CONFIG_HOME/aws/config"
