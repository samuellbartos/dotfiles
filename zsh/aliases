# MISC

alias l='ls -lahFGT'
alias tz='for i in $(seq 1 5); do time zsh -i -c exit; done'

# GIT

alias g='git'

# git autocompletion setup
compdef g='git'

# git add
alias ga='git add'
alias gap='git add --patch'
alias gau='git add --update'
alias gapu='git add --patch --update'

# git branch
alias gb='git branch'
alias gbf='git branch --force'
alias gbm='git branch --move'
alias gbd='git branch --delete'
alias gbD='git branch --delete --force'

# git commit
alias gcm='TZ=UTC git commit'
alias gcmf='TZ=UTC git commit --fixup'
alias gcma='TZ=UTC git commit --amend'
alias gcmm='TZ=UTC git commit --message'

# git checkout
alias gco='git checkout'

# git cherry-pick
alias gcp='git cherry-pick'
alias gcpc='git cherry-pick --continue'
alias gcpa='git cherry-pick --abort'

# git diff
alias gd='git diff'
alias gd@='git diff @^!'
alias gdc='git diff --cached'
alias gds='git diff --stat'
alias gds@='git diff --stat @^!'

# git fetch
alias gf='git fetch'

# git log
alias gl='git log --all --oneline --graph --pretty="%C(auto)%h -%d %s %C(blue)(%ci) <%an>%Creset"'

# git merge
alias gm='git merge'

# git push
alias gp='git push'
alias gpf='git push --force-with-lease'

# git rebase
alias gri='git rebase --committer-date-is-author-date --interactive'
alias gria='git rebase --committer-date-is-author-date --interactive --autosquash'
alias grc='git rebase --continue'
alias gra='git rebase --abort'
alias grix='git rebase --committer-date-is-author-date --interactive --exec'
alias grx='git rebase --committer-date-is-author-date --exec'

# git restore
alias grs='git restore --staged'

# git reset
alias grh='git reset --hard'
alias grm='git reset --mixed'

# git stash
alias gst='git stash'
alias gstk='git stash --keep-index'
alias gsts='git stash push --staged'
alias gstp='git stash pop'
alias gstd='git stash drop'
alias gstswp='git stash show --pretty'

# git status
alias gs='git status'
alias gss='git status --short'

# git switch
alias gsw='git switch'
alias gswc='git switch --create'
alias gswC='git switch --force-create'

# git tag
alias gt='git tag'

# prune orphaned local branches
alias gx="git for-each-ref refs/heads --format '%(refname:short) %(upstream:track,nobracket)' | awk '/ gone/{print \$1}' | xargs git branch --delete --force"

# tmux session setup
alias tns='source "$HOME/.tmux-session"'
